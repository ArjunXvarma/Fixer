# Fixer configuration — copy to .env and fill in the keys you have.
#
#   cp .env.example .env
#
# At least one provider key is required. The provider is chosen by
# FIXER_PROVIDER (default: gemini), and only that provider's key is needed.

# --- Provider keys (at least one) ---------------------------------------------

# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Optional selection -------------------------------------------------------

# gemini (default) | groq | openrouter
# FIXER_PROVIDER=groq

# Overrides the provider's default model.
# FIXER_MODEL=gemini-3.5-flash-lite
